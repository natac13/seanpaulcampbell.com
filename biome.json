{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.sst",
      "!**/sst-env.d.ts",
      "!!**/.turbo",
      "!!**/.cache",
      "!!**/build",
      "!!**/dist",
      "!!**/public/build",
      "!!**/playwright-report",
      "!!**/server-build",
      "!!**/.react-email",
      "!!**/.react-router",
      "!!**/*/.react-router",
      "!!**/.vscode",
      "!!**/.cursor",
      "!!**/.astro",
      "!!**/convex/_generated"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "style": {
        "useImportType": "error"
      },
      "correctness": {
        "noChildrenProp": "off",
        "noUnusedVariables": "warn",
        "noUnusedImports": {
          "level": "warn",
          "fix": "unsafe"
        },
        "noUnusedPrivateClassMembers": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "javascript": {
    "globals": ["Astro"],
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "noEmptyPattern": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/tsconfig/base.json",
        "packages/tsconfig/internal-package.json",
        "**/.vscode/**/*.json",
        "**/tsconfig*.json"
      ],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": false
        }
      }
    },
    {
      "includes": ["packages/email/**/*", "packages/functions/**/*", "packages/core/**/*"],
      "javascript": {
        "jsxRuntime": "reactClassic"
      }
    },
    {
      "includes": ["examples/**/*"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "info",
            "noBlankTarget": "info"
          },
          "a11y": {
            "useButtonType": "info",
            "noAutofocus": "info"
          },
          "correctness": {
            "noUnusedImports": "info",
            "noUnusedVariables": "info",
            "useExhaustiveDependencies": "info"
          },
          "suspicious": {
            "noShorthandPropertyOverrides": "info",
            "noExplicitAny": "info",
            "noDuplicateProperties": "info"
          },
          "style": {
            "noNonNullAssertion": "info"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
