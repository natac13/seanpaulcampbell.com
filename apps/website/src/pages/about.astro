---
import avatar from '../assets/images/avatar.jpg'
import TapedPhoto from '../components/TapedPhoto.astro'
import { SOCIAL_LINKS } from '../constants'
import Layout from '../layouts/Layout.astro'

export const prerender = true

const STACK = [
  { area: 'Front end', items: 'React, React Router, Astro, Tailwind' },
  { area: 'Back end', items: 'TypeScript on Node, and Go when it fits' },
  { area: 'Cloud', items: 'AWS serverless: Lambda, DynamoDB, EventBridge, all wired up with SST' },
] as const
---

<Layout title="About">
  <main class="wrap about">
    <div class="about-grid">
      <div class="about-photo">
        <TapedPhoto src={avatar} alt="Sean Campbell" size={200} tilt={-2.5} />
        <p class="note" aria-hidden="true">usually found on a trail somewhere</p>
      </div>
      <div class="about-copy">
        <h1>Hi, I'm Sean.</h1>
        <p>
          I'm a software developer. Most days that means React on the front and TypeScript on AWS behind
          it. I write here when I've solved something fiddly, like auth across a few services or
          self-hosting a backend on my own account, and the docs didn't get me all the way there.
        </p>
        <p>
          When a problem won't budge I go for a run. More than one of these posts started as a better
          idea somewhere around the halfway mark.
        </p>
        <h2>What I work with</h2>
        <dl class="stack">
          {
            STACK.map((s) => (
              <div>
                <dt>{s.area}</dt>
                <dd>{s.items}</dd>
              </div>
            ))
          }
        </dl>
        <h2>Find me</h2>
        <ul class="social">
          {
            SOCIAL_LINKS.map((s) => (
              <li>
                <a href={s.href} rel="me noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>
</Layout>

<style>
  .about {
    padding: 64px 0 96px;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
    max-width: 900px;
  }
  .about-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-top: 8px;
  }
  .about-photo .note {
    text-align: center;
    transform: rotate(-3deg);
  }
  .about-copy {
    max-width: 62ch;
  }
  .about-copy h1 {
    margin: 0 0 18px;
    font: 700 clamp(2.8rem, 7vw, 4.4rem) / 0.95 var(--font-cond);
  }
  .about-copy p {
    margin: 0 0 1em;
  }
  .about-copy h2 {
    margin: 44px 0 14px;
    font: 700 1.8rem / 1 var(--font-cond);
  }
  .stack {
    margin: 0;
    border-left: 3px solid var(--heavy);
  }
  .stack div {
    padding: 10px 0 10px 20px;
  }
  .stack dt {
    font: 600 1.2rem / 1.2 var(--font-cond);
  }
  .stack dd {
    margin: 2px 0 0;
    color: var(--text-2);
  }
  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .social a {
    display: inline-block;
    padding: 8px 16px;
    border: 2px solid var(--heavy);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .social a:hover {
    background: var(--heavy);
    color: var(--on-heavy);
  }
  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .about-photo {
      --photo-size: 140px;
      flex-direction: row;
      align-items: center;
      gap: 22px;
      padding-left: 12px;
    }
    .about-photo .note {
      text-align: left;
    }
  }
</style>
