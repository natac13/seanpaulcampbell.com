---
import avatar from '../assets/images/avatar.jpg'
import RouteList from '../components/RouteList.astro'
import TapedPhoto from '../components/TapedPhoto.astro'
import TopoHero from '../components/TopoHero.astro'
import Layout from '../layouts/Layout.astro'
import { getRouteCheckpoints } from '../lib/posts'

export const prerender = true

const checkpoints = await getRouteCheckpoints()
const totalMinutes = checkpoints.reduce((sum, c) => sum + c.minutes, 0)
---

<Layout>
  <TopoHero slot="hero" size="full">
    <div class="hero-copy">
      <h1>Sean<br />Campbell</h1>
      <p>
        I build web apps and the AWS plumbing behind them, then write up what worked so you can skip
        the parts that didn't. Most of these ideas got sorted out on a run.
      </p>
    </div>
    <aside class="hero-photo" aria-hidden="true">
      <TapedPhoto src={avatar} alt="" size={132} tilt={3} />
      <p class="note">
        <svg class="arrow" viewBox="0 0 90 60"><path d="M8 54 C 30 56, 62 46, 82 12 M82 12 l-13 5 M82 12 l1 14" /></svg>
        close enough, that's me
      </p>
    </aside>
  </TopoHero>

  <main class="wrap home">
    <div class="route-head">
      <h2>The log</h2>
      <p>{checkpoints.length} posts, about {totalMinutes} minutes of reading end to end.</p>
    </div>
    <RouteList checkpoints={checkpoints} trailhead={true} />
  </main>
</Layout>

<style>
  .hero-copy {
    position: relative;
    z-index: 1;
    margin-top: auto;
    width: min(100% - 32px, 1240px);
    margin-inline: auto;
    padding-bottom: clamp(48px, 9vh, 96px);
  }
  .hero-copy h1 {
    margin: 0;
    font: 700 clamp(4.2rem, 15vw, 12.5rem) / 0.82 var(--font-cond);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .hero-copy p {
    max-width: 34ch;
    margin: 28px 0 0;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    color: var(--hero-sub);
  }
  .hero-photo {
    position: absolute;
    z-index: 1;
    right: max(32px, calc((100% - 1240px) / 2 + 24px));
    bottom: clamp(56px, 11vh, 110px);
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .hero-photo .note {
    order: -1;
    color: var(--blaze);
    margin-top: 40px;
    width: 130px;
    text-align: right;
    transform: rotate(-5deg);
  }
  .arrow {
    display: block;
    width: 52px;
    height: 34px;
    margin: 0 0 4px auto;
  }
  .arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .home {
    padding: 72px 0 96px;
  }
  .route-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    margin-bottom: 40px;
  }
  .route-head h2 {
    margin: 0;
    font: 700 2.6rem / 1 var(--font-cond);
  }
  .route-head p {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .hero-photo {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .hero-copy h1 {
      font-size: 22vw;
    }
  }
</style>
