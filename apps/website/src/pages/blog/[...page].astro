---
import type { GetStaticPathsOptions, Page } from 'astro'
import PageIntro from '../../components/PageIntro.astro'
import RouteList from '../../components/RouteList.astro'
import TagPills from '../../components/TagPills.astro'
import { SITE } from '../../constants'
import Layout from '../../layouts/Layout.astro'
import { getAllTags, getRouteCheckpoints } from '../../lib/posts'
import type { RouteCheckpoint } from '../../lib/route'

export const prerender = true

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(await getRouteCheckpoints(), { pageSize: SITE.postsPerPage })
}

const { page } = Astro.props as { page: Page<RouteCheckpoint> }
const allTags = await getAllTags()
const pageUrl = (n: number): string => (n === 1 ? '/blog' : `/blog/${n}`)
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1)
---

<Layout title={`Writing${page.currentPage > 1 ? ` - Page ${page.currentPage}` : ''}`}>
  <main class="wrap archive">
    <PageIntro title="Writing">
      <p>{page.total} posts on building web apps and the AWS plumbing behind them.</p>
    </PageIntro>
    <section class="topics" aria-label="Topics">
      <TagPills tags={allTags} />
    </section>
    <RouteList checkpoints={page.data} trailhead={page.currentPage === page.lastPage} />
    {
      page.lastPage > 1 && (
        <nav class="pager" aria-label="Pagination">
          {page.url.prev ? <a href={page.url.prev}>Newer</a> : <span />}
          <ol>
            {pages.map((n) => (
              <li>
                <a href={pageUrl(n)} aria-current={n === page.currentPage ? 'page' : undefined}>
                  {n}
                </a>
              </li>
            ))}
          </ol>
          {page.url.next ? <a href={page.url.next}>Older</a> : <span />}
        </nav>
      )
    }
  </main>
</Layout>

<style>
  .archive {
    padding: 64px 0 96px;
  }
  .topics {
    margin-bottom: 56px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 56px;
    font: 600 1.15rem / 1 var(--font-cond);
  }
  .pager ol {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pager a {
    text-decoration: none;
    padding: 6px 10px;
    border-bottom: 2px solid transparent;
  }
  .pager a:hover,
  .pager a[aria-current] {
    border-color: var(--blaze);
  }
</style>
