---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import PostHead from '../../components/PostHead.astro'
import Layout from '../../layouts/Layout.astro'
import { getAllPosts } from '../../lib/posts'
import { calculateReadingTime } from '../../lib/readingTime'
import { formatDate } from '../../lib/utils'

export const prerender = true

export async function getStaticPaths() {
  const allPosts = await getAllPosts()
  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const minutes = calculateReadingTime(post.body ?? '')
---

<Layout title={post.data.title}>
  <PostHead post={post} slot="head" />

  <div class="progress" aria-hidden="true"><span class="fill"></span></div>
  <main class="wrap post">
    <article>
      <header class="post-head">
        <a class="back" href="/blog">Back to the log</a>
        <h1 transition:name={`blog-title-${post.id}`}>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <dl class="stats">
          <div>
            <dt>Posted</dt>
            <dd><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></dd>
          </div>
          <div>
            <dt>Reading</dt>
            <dd>{minutes} min</dd>
          </div>
          {
            post.data.tags.length > 0 && (
              <div>
                <dt>Tags</dt>
                <dd>
                  {post.data.tags.map((tag, i) => (
                    <>{i > 0 && ', '}<a href={`/tags/${tag}`}>{tag}</a></>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
        {
          post.data.image && (
            <Image class="cover" src={post.data.image.src} alt={post.data.image.alt} width={1200} height={630} />
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<script>
  // The red route fills as you read. astro:page-load also fires after ClientRouter navigations.
  let onScroll: (() => void) | undefined
  document.addEventListener('astro:page-load', () => {
    if (onScroll) window.removeEventListener('scroll', onScroll)
    onScroll = undefined
    const fill = document.querySelector<HTMLElement>('.progress .fill')
    if (!fill) return
    const update = (): void => {
      const max = document.documentElement.scrollHeight - window.innerHeight
      const p = max > 0 ? Math.min(1, window.scrollY / max) : 0
      fill.style.transform = `scaleX(${p})`
    }
    onScroll = () => requestAnimationFrame(update)
    window.addEventListener('scroll', onScroll, { passive: true })
    update()
  })
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--progress-track) 0 10px, transparent 10px 16px);
    z-index: 50;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--progress-fill);
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: transform 0.12s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .fill {
      transition: none;
    }
  }
  .post {
    padding: 0 0 96px;
  }
  .post article {
    max-width: 760px;
    margin-inline: auto;
  }
  .post-head {
    padding: 44px 0 0;
  }
  .back {
    font: 600 1.05rem / 1 var(--font-cond);
    color: var(--muted);
  }
  .post-head h1 {
    margin: 20px 0 14px;
    font: 700 clamp(2.4rem, 6vw, 3.9rem) / 0.98 var(--font-cond);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--text-2);
    margin: 0 0 26px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin: 0 0 40px;
    padding: 16px 0;
    border-top: 3px solid var(--heavy);
    border-bottom: 1px solid var(--rule);
  }
  .stats dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .stats dd {
    margin: 0;
    font: 600 1.25rem / 1.2 var(--font-cond);
  }
  .stats dd a {
    text-decoration: none;
  }
  .stats dd a:hover {
    text-decoration: underline;
    text-decoration-color: var(--marker);
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 0 0 40px;
  }

  .prose {
    font-size: 1.1rem;
    line-height: 1.72;
    overflow-wrap: break-word;
  }
  .prose :global(h2) {
    font: 700 2rem / 1.1 var(--font-cond);
    margin: 2.4em 0 0.5em;
    padding-left: 16px;
    border-left: 5px solid var(--blaze);
  }
  .prose :global(:is(h2, h3, h4) a) {
    color: inherit;
    text-decoration: none;
  }
  .prose :global(h3) {
    font: 600 1.5rem / 1.2 var(--font-cond);
    margin: 1.8em 0 0.4em;
  }
  .prose :global(h4) {
    font-weight: 600;
    margin: 1.5em 0 0.4em;
  }
  .prose :global(:is(h2, h3, h4)) {
    scroll-margin-top: 24px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.5em;
  }
  .prose :global(li) {
    margin: 0.3em 0;
  }
  .prose :global(li::marker) {
    color: var(--marker);
  }
  .prose :global(a) {
    color: var(--link);
    text-decoration-color: var(--marker);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(:not(pre) > code) {
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 0.12em 0.38em;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .prose :global(img) {
    border-radius: 6px;
    margin: 1.6em 0;
    height: auto;
  }
  .prose :global(blockquote) {
    margin: 1.4em 0;
    padding: 0.2em 0 0.2em 18px;
    border-left: 3px solid var(--muted);
    color: var(--text-2);
  }
  .prose :global(hr) {
    margin: 2.4em 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }
  .prose :global(.expressive-code) {
    margin: 1.6em 0;
    max-width: 100%;
  }
  .prose :global(.expressive-code pre) {
    max-width: 100%;
  }
  @media (max-width: 640px) {
    .post-head {
      padding-top: 28px;
    }
  }
</style>
