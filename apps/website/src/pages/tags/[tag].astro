---
import type { GetStaticPaths } from 'astro'
import PageIntro from '../../components/PageIntro.astro'
import RouteList from '../../components/RouteList.astro'
import Layout from '../../layouts/Layout.astro'
import { getAllTags, getRouteCheckpoints } from '../../lib/posts'

export const prerender = true

export const getStaticPaths = (async () => {
  const [allTags, checkpoints] = await Promise.all([getAllTags(), getRouteCheckpoints()])
  return allTags.map(({ tag }) => ({
    params: { tag },
    props: { checkpoints: checkpoints.filter((c) => c.post.data.tags.includes(tag)) },
  }))
}) satisfies GetStaticPaths

const { tag } = Astro.params
const { checkpoints } = Astro.props
---

<Layout title={`Posts tagged with "${tag}"`}>
  <main class="wrap tagged">
    <a class="back" href="/tags">All tags</a>
    <PageIntro title={tag} kicker="Tagged">
      <p>{checkpoints.length} {checkpoints.length === 1 ? 'post' : 'posts'} on this part of the map.</p>
    </PageIntro>
    <RouteList checkpoints={checkpoints} trailhead={false} />
  </main>
</Layout>

<style>
  .tagged {
    padding: 44px 0 96px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font: 600 1.05rem / 1 var(--font-cond);
    color: var(--muted);
  }
</style>
