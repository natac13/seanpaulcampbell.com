---
import PageIntro from '../components/PageIntro.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="404 - Page Not Found">
  <main class="wrap lost">
    <PageIntro title="Off the map" kicker="404">
      <p>This trail doesn't go anywhere. The page you're after doesn't exist.</p>
    </PageIntro>
    <a class="home" href="/">Back to the log</a>
  </main>
</Layout>

<style>
  .lost {
    padding: 64px 0 120px;
  }
  .home {
    display: inline-block;
    padding: 8px 16px;
    border: 2px solid var(--heavy);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .home:hover {
    background: var(--heavy);
    color: var(--on-heavy);
  }
</style>
