    "sst": "3.13.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tsconfig/node20": "^20.1.10",
    "@types/aws-lambda": "8.10.149",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
