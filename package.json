{
  "name": "seanpaulcampbell",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "aws:sso": "aws sso login --sso-session=personal-session",
    "dev": "sst dev",
    "format": "biome format --write .",
